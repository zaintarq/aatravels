rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == 'yes'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == 'true'
        );
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.username is string
        && request.resource.data.isAdmin == false;
      allow update: if isSelf(uid)
        && request.resource.data.isAdmin == resource.data.isAdmin;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    match /enquiries/{id} {
      allow create: if true;
      allow read, update: if false;
    }

    match /contacts/{id} {
      allow create: if true;
      allow read, update: if false;
    }

    match /travelAgents/{id} {
      allow create: if true;
      allow read, update: if false;
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.firebaseUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /hotelListings/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /packages/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /newsletterSubscribers/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Used by Firebase Extension: "Trigger Email from Firestore"
    match /mail/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /testimonials/{id} {
      allow read: if resource.data.approved == true;
      allow write: if false;
    }
  }
}
